#!/bin/sh
# persona-stack pre-commit gate: bundle immutability + portable authority tables.
# verify.py recomputes every bundle hash and rejects machine-local paths in
# bindings.json / bundle index.json.
python verify.py || {
    cat >&2 <<'EOF'
commit blocked: registry integrity check failed.

A published bundle's content no longer matches its hash (directory name), or the
authoritative tables carry a machine-local path. Editing happens in sources/<id>/
— then `python persona.py publish`. To restore a tampered bundle: git checkout -- bundles/
Machine paths belong in targets.local.json (gitignored), not bindings.json.
EOF
    exit 1
}

# adapter round-trips: place → readback → remove must stay byte-exact. The
# remove path is the one that deletes from a host, so it ships guarded.
python -m unittest discover -s tests >/dev/null 2>&1 || {
    echo "commit blocked: adapter round-trip tests failed — run: python -m unittest discover -s tests" >&2
    exit 1
}
