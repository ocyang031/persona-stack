#!/bin/sh
# persona-stack pre-commit gate: bundles immutability is enforced here.
# Recomputes every bundle's content hash; a modified published bundle
# fails the commit with instructions.
python verify.py || {
    cat >&2 <<'EOF'
commit blocked: bundles integrity check failed.

A published bundle's content no longer matches its hash (directory name).
Editing happens in sources/<id>/ — then `python persona.py publish`.
To restore a tampered bundle: git checkout -- bundles/
EOF
    exit 1
}

# adapter round-trips: place → readback → remove must stay byte-exact. The
# remove path is the one that deletes from a host, so it ships guarded.
python -m unittest discover -s tests >/dev/null 2>&1 || {
    echo "commit blocked: adapter round-trip tests failed — run: python -m unittest discover -s tests" >&2
    exit 1
}
